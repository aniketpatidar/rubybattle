<%= form_with(model: post, class: "space-y-4") do |form| %>
  <% if post.errors.any? %>
    <div id="error_explanation" class="ck-card mb-4" style="border-color: rgba(248,113,113,0.3);">
      <div class="ck-meta mb-2" style="color: #f87171;"><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved</div>
      <ul class="space-y-1">
        <% post.errors.each do |error| %>
          <li class="text-sm font-bold" style="color: #f87171;"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "ck-meta block mb-1" %>
    <%= form.text_field :title, class: "ck-input" %>
  </div>

  <div>
    <%= form.label :body, class: "ck-meta block mb-1" %>
    <%= form.rich_text_area :body, class: "ck-input" %>
  </div>

  <div>
    <%= form.submit class: "ck-btn-primary", style: "cursor: pointer;" %>
  </div>
<% end %>