<div class="ck-page">
  <section class="mb-8 border-4 border-black bg-ck-secondary p-5 shadow-[8px_8px_0_0_#000] sm:p-8 lg:p-10">
    <div class="ck-sticker mb-5">Posts</div>
    <h1 class="ck-heading">New Post</h1>
  </section>

  <div class="ck-card max-w-2xl">
    <%= render "form", post: @post %>
  </div>

  <div class="mt-6">
    <%= link_to "← Back to Posts", posts_path, class: "ck-btn-outline" %>
  </div>
</div>