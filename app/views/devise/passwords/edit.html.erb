<div class="flex items-center justify-center min-h-screen px-4">
  <div class="w-full max-w-md">
    <div class="ck-meta mb-1 text-center">Account recovery</div>
    <div class="ck-heading text-center mb-8">Change Password</div>

    <div class="ck-card" style="padding: 32px;">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="space-y-4">
          <div>
            <%= f.label :password, "New password", class: "ck-meta block mb-1" %>
            <% if @minimum_password_length %>
              <span class="ck-meta ml-2 normal-case text-[10px]">(<%= @minimum_password_length %> characters minimum)</span>
            <% end %>
            <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "ck-input mt-1" %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirm new password", class: "ck-meta block mb-1" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "ck-input" %>
          </div>

          <%= f.submit "Change my password", class: "ck-btn-primary w-full mt-2", style: "cursor: pointer;" %>
        </div>
      <% end %>

      <div class="mt-6 space-y-2 text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>