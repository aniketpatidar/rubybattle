<p>Hey <%= @email %>,</p>

<% if @resource.try(:unconfirmed_email?) %>
  <p>We're letting you know your email is being changed to <strong><%= @resource.unconfirmed_email %></strong>.</p>
<% else %>
  <p>We're letting you know your email has been changed to <strong><%= @resource.email %></strong>.</p>
<% end %>