<div class="ck-page overflow-hidden">
  <section class="relative mb-8 border-4 border-black bg-ck-secondary p-5 shadow-[8px_8px_0_0_#000] sm:p-8 lg:p-10">
    <div class="absolute -right-8 -top-8 hidden h-28 w-28 rotate-12 border-4 border-black bg-ck-accent shadow-[6px_6px_0_0_#000] lg:block"></div>
    <div class="relative">
      <div class="ck-sticker mb-5">Admin · Categories</div>
      <h1 class="ck-heading max-w-4xl">Edit Category</h1>
    </div>
  </section>

  <div class="ck-card max-w-2xl">
    <%= render "form", category: @category %>
  </div>

  <div class="mt-6 flex gap-4">
    <%= link_to "← Back to Category", admin_category_path(@category), class: "ck-btn-outline" %>
    <%= link_to "All Categories", admin_categories_path, class: "ck-btn-outline" %>
  </div>
</div>