<div class="ck-page overflow-hidden">
  <section class="relative mb-8 border-4 border-black bg-ck-muted p-5 shadow-[8px_8px_0_0_#000] sm:p-8 lg:p-10">
    <div class="absolute -right-8 -top-8 hidden h-28 w-28 rotate-12 border-4 border-black bg-ck-accent shadow-[6px_6px_0_0_#000] lg:block"></div>
    <div class="relative">
      <div class="ck-sticker mb-5">Admin · Categories</div>
      <h1 class="ck-heading max-w-4xl"><%= @category.name %></h1>
    </div>
  </section>

  <div class="ck-stat-grid grid-cols-2 mb-8 max-w-lg">
    <div>
      <div class="ck-meta mb-1">Discussions</div>
      <div class="text-3xl font-black tabular-nums"><%= @category.discussions.count %></div>
    </div>
    <div>
      <div class="ck-meta mb-1">Created</div>
      <div class="text-lg font-black"><%= @category.created_at.strftime("%b %d, %Y") %></div>
    </div>
  </div>

  <div class="flex gap-3">
    <%= link_to "Edit", edit_admin_category_path(@category), class: "ck-btn-primary" %>
    <%= button_to "Delete", admin_category_path(@category), method: :delete,
        data: { confirm: "Delete '#{@category.name}'? This cannot be undone." },
        class: "ck-btn-outline",
        style: "color: #f87171; border-color: rgba(248,113,113,0.3); cursor: pointer;" %>
  </div>

  <div class="mt-6">
    <%= link_to "← All Categories", admin_categories_path, class: "ck-btn-outline" %>
  </div>
</div>