<div class="ck-page overflow-hidden">
  <section class="relative mb-8 border-4 border-black bg-ck-accent p-5 shadow-[8px_8px_0_0_#000] sm:p-8 lg:p-10">
    <div class="absolute -right-8 -top-8 hidden h-28 w-28 rotate-12 border-4 border-black bg-ck-secondary shadow-[6px_6px_0_0_#000] lg:block"></div>
    <div class="relative">
      <div class="ck-sticker mb-5">Admin</div>
      <h1 class="ck-heading max-w-4xl">Settings</h1>
    </div>
  </section>

  <div class="ck-card max-w-2xl">
    <div class="ck-meta mb-4">Feature Toggles</div>

    <form action="<%= admin_settings_path %>" method="POST">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <input type="hidden" name="setting" value="ai_hints_enabled">

      <div class="flex items-center justify-between gap-4 border-4 border-black bg-ck-bg p-4 shadow-[4px_4px_0_0_#000]">
        <div>
          <p class="text-lg font-black uppercase leading-none text-ck-ink">AI Hints</p>
          <p class="ck-meta mt-1">Show AI-powered hints on challenges</p>
        </div>
        <label class="ck-toggle shrink-0">
          <input type="checkbox" name="value" value="true" <%= "checked" if @ai_hints_enabled %>
                 onchange="this.form.submit()">
          <div class="ck-toggle-track"></div>
          <div class="ck-toggle-thumb"></div>
        </label>
      </div>
    </form>
  </div>

  <div class="mt-6">
    <%= link_to "← Back to Home", home_path, class: "ck-btn-outline" %>
  </div>
</div>