<% sent_invitation = current_user.sent_invitations.find { |inv| inv.friend_id == user.id } %>
<% received_invitation = current_user.received_invitations.find { |inv| inv.user_id == user.id } %>

<% case friendship_state(current_user, user)
   when :none %>
  <%= form_with(url: invitations_path, method: :post, local: true) do |form| %>
    <%= form.hidden_field :user_id, value: user.id %>
    <%= form.submit "Connect", class: "ck-btn-primary", style: "cursor: pointer;" %>
  <% end %>
<% when :invitation_sent %>
  <span class="ck-chip ck-chip--outline">Pending</span>
<% when :invitation_received %>
  <div class="flex gap-2">
    <%= button_to "Accept", accept_invitation_path(received_invitation), method: :post, class: "ck-btn-primary", style: "cursor: pointer;" %>
    <%= button_to "Decline", decline_invitation_path(received_invitation), method: :post, class: "ck-btn-outline", style: "cursor: pointer;" %>
  </div>
<% when :friends %>
  <span class="ck-chip ck-chip--completed">Connected</span>
<% end %>