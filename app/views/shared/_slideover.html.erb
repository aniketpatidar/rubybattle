<div data-slideover-target="slideover" class="fixed -right-full top-0 z-40 flex h-screen w-full flex-1 flex-col overflow-y-auto border-l-4 border-black bg-ck-bg shadow-[-8px_0_0_0_#000] transition-all duration-500 lg:-right-1/3 lg:w-1/3">
  <div class="flex items-center justify-between gap-4 border-b-4 border-black bg-ck-secondary px-4 py-4">
    <h3 class="text-2xl font-black uppercase leading-none text-ck-ink" id="slideover-header"></h3>
    <button data-action="slideover#close" class="ck-btn-outline h-12 w-12 min-h-0 shrink-0 p-0" aria-label="Close slideover">
      <%= inline_svg_tag 'close.svg', class: "h-6 w-6" %>
    </button>
  </div>
  <div class="px-4 py-5 text-ck-ink">
    <div id="slideover-content"></div>
  </div>
</div>
