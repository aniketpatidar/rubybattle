<div class="fixed bottom-6 right-6 z-50 pointer-events-none">
  <div data-controller="alert"
       class="ck-card ck-card--quiet max-w-sm w-full pointer-events-auto px-4 py-3 flex items-start gap-3 <%= level.to_s == 'alert' ? 'bg-ck-accent' : 'bg-ck-secondary' %>">
    <div class="flex-1 min-w-0">
      <div class="ck-meta mb-1">
        <%= level.to_s == 'alert' ? 'Error' : 'Notice' %>
      </div>
      <p class="text-[15px] font-bold leading-snug text-ck-ink"><%= content %></p>
    </div>
    <button data-action="alert#close"
            class="ck-btn-outline shrink-0 h-10 w-10 min-h-0 p-0"
            aria-label="Close notification">
      <%= inline_svg_tag 'close.svg', class: 'h-5 w-5' %>
    </button>
  </div>
</div>
