<% tests = JSON.parse(@challenge.tests) rescue [] %>

<div class="ck-page overflow-hidden">
  <section class="relative mb-8 border-4 border-black bg-ck-muted p-5 shadow-[8px_8px_0_0_#000] sm:p-8 lg:p-10">
    <div class="absolute -right-8 -top-8 hidden h-28 w-28 rotate-12 border-4 border-black bg-ck-secondary shadow-[6px_6px_0_0_#000] lg:block"></div>
    <div class="relative">
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <span class="ck-sticker">Collaborative Room</span>
        <span class="ck-chip ck-chip--<%= @challenge.difficulty.downcase %>"><%= @challenge.difficulty %></span>
        <span class="ck-chip ck-chip--outline">Room <%= @room_id.to_s.first(8) %></span>
      </div>
      <h1 class="ck-heading max-w-5xl"><%= @challenge.name %></h1>
    </div>
  </section>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)]">
    <aside class="space-y-6">
      <section class="ck-card ck-card--quiet bg-white">
        <div class="ck-meta mb-3">Brief</div>
        <div class="text-lg font-bold leading-relaxed text-ck-ink">
          <%= simple_format(@challenge.description) %>
        </div>
      </section>

      <section class="ck-stat-grid grid-cols-1 sm:grid-cols-3 xl:grid-cols-1">
        <div>
          <div class="ck-meta mb-2">Language</div>
          <div class="text-2xl font-black uppercase"><%= @challenge.respond_to?(:language) && @challenge.language.present? ? @challenge.language : 'Ruby' %></div>
        </div>
        <div class="bg-ck-secondary">
          <div class="ck-meta mb-2">Tests</div>
          <div class="text-2xl font-black uppercase"><%= tests.is_a?(Array) ? tests.length : 0 %> cases</div>
        </div>
        <div class="bg-ck-accent">
          <div class="ck-meta mb-2">Mode</div>
          <div class="text-2xl font-black uppercase">Shared</div>
        </div>
      </section>
    </aside>

    <section class="space-y-6" data-controller="codemirror">
      <div class="ck-card ck-card--quiet bg-white">
        <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <div class="ck-meta mb-2">Shared Solution</div>
            <h2 class="text-3xl font-black uppercase leading-none">Pair on Ruby</h2>
          </div>
          <div class="rotate-2 border-4 border-black bg-ck-secondary px-3 py-2 text-sm font-black uppercase shadow-[3px_3px_0_0_#000]">
            Live room
          </div>
        </div>

        <div id="code-editor"
             data-codemirror-context
             data-method-template="<%= @challenge.method_template %>"
             data-tests="<%= @challenge.tests %>"
             data-challenge-id="<%= @challenge.id %>"
             data-room-id="<%= @room_id %>">
          <textarea
            class="w-full resize-none font-mono text-sm"
            data-codemirror-target="editor"
          ></textarea>
        </div>

        <div class="mt-5">
          <button data-action="click->codemirror#run" class="ck-btn-primary w-full">
            Run Shared Code
          </button>
        </div>
      </div>

      <div class="ck-card ck-card--quiet bg-ck-secondary">
        <div class="ck-meta mb-3">Test Results</div>
        <div class="min-h-[220px] overflow-auto border-4 border-black bg-white p-4 font-mono text-sm font-bold leading-relaxed text-ck-ink shadow-[4px_4px_0_0_#000]">
          <pre data-codemirror-target="output">Awaiting code submission</pre>
        </div>
      </div>
    </section>
  </div>
</div>
