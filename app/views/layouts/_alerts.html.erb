<% if notice %>
  <div class="ck-card bg-ck-secondary mb-4 flex items-center gap-3 text-sm font-black uppercase shadow-[4px_4px_0_0_#000]">
    <p><%= notice %></p>
  </div>
<% end %>
<% if alert %>
  <div class="ck-card mb-4 flex items-center gap-3 text-sm font-black uppercase shadow-[4px_4px_0_0_#000]" style="border-color: rgba(248,113,113,0.3);">
    <p style="color: #f87171;"><%= alert %></p>
  </div>
<% end %>