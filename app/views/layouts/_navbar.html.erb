<header class="border-b-4 border-black bg-ck-card shadow-[0_4px_0_0_#000]">
  <nav class="mx-auto flex max-w-screen-2xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <div class="flex items-center gap-8">
      <%= link_to "/", class: "flex items-center gap-2 font-black text-xl uppercase tracking-tight text-ck-ink" do %>
        <span class="inline-block rotate-[-3deg] border-4 border-black bg-ck-accent px-3 py-1 text-sm shadow-[3px_3px_0_0_#000]">CK</span>
        <span class="hidden sm:inline">CodeKata</span>
      <% end %>
    </div>

    <div class="flex items-center gap-1 sm:gap-3">
      <%= link_to "Home", "/", class: "px-3 py-2 text-sm font-black uppercase text-ck-ink hover:bg-ck-secondary transition-colors" %>
      <%= link_to "Challenges", challenges_path, class: "px-3 py-2 text-sm font-black uppercase text-ck-ink hover:bg-ck-secondary transition-colors" %>
      <%= link_to "Invitations", invitations_path, class: "px-3 py-2 text-sm font-black uppercase text-ck-ink hover:bg-ck-secondary transition-colors" %>
      <%= link_to "Users", users_path, class: "px-3 py-2 text-sm font-black uppercase text-ck-ink hover:bg-ck-secondary transition-colors" %>
      <%= link_to "Categories", categories_path, class: "px-3 py-2 text-sm font-black uppercase text-ck-ink hover:bg-ck-secondary transition-colors" %>

      <div class="relative ml-2" data-controller="dropdown">
        <button class="flex items-center gap-2 border-4 border-black bg-ck-secondary px-3 py-2 text-sm font-black uppercase shadow-[3px_3px_0_0_#000] hover:translate-x-[-1px] hover:translate-y-[-1px] transition-transform" data-action="click->dropdown#toggle">
          <span class="flex h-6 w-6 items-center justify-center rounded-full border-2 border-black bg-white text-[9px] font-black">
            <%= current_user.initials %>
          </span>
          <span class="hidden sm:inline"><%= current_user.first_name %></span>
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"/>
          </svg>
        </button>
        <div class="absolute right-0 top-full z-50 mt-1 hidden w-48 border-4 border-black bg-white shadow-[6px_6px_0_0_#000]" data-dropdown-target="menu">
          <%= link_to "View Profile", "/users/#{current_user.slug}", class: "block border-b-4 border-black px-4 py-3 text-sm font-black uppercase text-ck-ink hover:bg-ck-secondary" %>
          <%= link_to "Edit Profile", edit_user_registration_path, class: "block border-b-4 border-black px-4 py-3 text-sm font-black uppercase text-ck-ink hover:bg-ck-secondary" %>
          <%= link_to "Ask a Question", new_discussion_path, class: "block border-b-4 border-black px-4 py-3 text-sm font-black uppercase text-ck-ink hover:bg-ck-secondary" %>
          <%= link_to "Sign Out", destroy_user_session_path, data: { turbo_method: "delete" }, class: "block px-4 py-3 text-sm font-black uppercase text-ck-ink hover:bg-ck-secondary" %>
        </div>
      </div>

      <div class="flex items-center justify-center">
        <%= turbo_stream_from current_user, :notifications %>
        <%= render "nav/notifications", user: current_user %>
      </div>
    </div>
  </nav>
</header>