<aside class="fixed inset-x-0 top-0 z-40 border-b-4 border-black bg-ck-bg shadow-[0_8px_0_0_#000] lg:inset-y-0 lg:right-auto lg:h-screen lg:w-[280px] lg:border-b-0 lg:border-r-4 lg:shadow-[8px_0_0_0_#000]">
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-3 border-b-4 border-black bg-ck-secondary px-4 py-3 lg:block lg:px-5 lg:pb-5 lg:pt-6">
      <a href="<%= user_signed_in? ? home_path : root_path %>" class="inline-flex rotate-[-1deg] items-center border-4 border-black bg-ck-accent px-3 py-2 shadow-[4px_4px_0_0_#000] transition-transform duration-100 hover:rotate-1">
        <span class="text-xl font-black uppercase leading-none tracking-normal text-ck-ink sm:text-2xl">CodeKata</span>
      </a>
      <div class="ck-meta hidden lg:mt-3 lg:block">Ruby combat lab</div>
      <% if user_signed_in? %>
        <div class="flex items-center gap-2 lg:hidden">
          <%= turbo_stream_from current_user, :notifications %>
          <%= render "nav/notifications", user: current_user %>
          <a href="<%= user_path(current_user) %>" class="flex h-11 w-11 items-center justify-center rounded-full border-4 border-black bg-ck-muted text-sm font-black text-ck-ink shadow-[3px_3px_0_0_#000]" aria-label="View profile">
            <%= current_user.initials %>
          </a>
        </div>
      <% end %>
    </div>

    <nav class="flex gap-2 overflow-x-auto px-3 py-3 lg:flex-1 lg:flex-col lg:gap-3 lg:overflow-x-visible lg:px-4 lg:py-5">
      <% if user_signed_in? %>
        <% [
          [home_path,        "Home",        "M3 12l2-3m0 0l7-4 7 4M5 9v10a1 1 0 001 1h12a1 1 0 001-1V9m-9 4v4m4-4v4",       -> { current_page?(home_path) }, "bg-ck-accent"],
          [challenges_path,  "Challenges",  "M13 10V3L4 14h7v7l9-11h-7z",                                                      -> { request.path.start_with?('/challenges') }, "bg-ck-secondary"],
          [new_game_path,    "Play",        "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z", -> { request.path.start_with?('/games') }, "bg-ck-accent"],
          [discussions_path, "Discussions", "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z", -> { request.path.start_with?('/discussions') }, "bg-ck-muted"],
          [invitations_path, "Friends",     "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z", -> { current_page?(invitations_path) }, "bg-white"],
        ].each_with_index do |(path, label, icon_d, active_fn, color_class), index| %>
          <% active = active_fn.call %>
          <a href="<%= path %>"
             class="group flex min-w-max items-center gap-2 border-4 border-black px-3 py-2 text-sm font-black uppercase leading-none shadow-[4px_4px_0_0_#000] transition-transform duration-100 lg:min-w-0 lg:gap-3 lg:px-4 lg:py-3 lg:text-base <%= active ? "#{color_class} translate-x-[2px] translate-y-[2px] shadow-none rotate-[-1deg]" : 'bg-white hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[7px_7px_0_0_#000]' %>">
            <svg class="h-5 w-5 shrink-0 lg:h-6 lg:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="<%= icon_d %>"></path>
            </svg>
            <span><%= label %></span>
            <% if active %>
              <span class="ml-auto hidden rounded-full border-2 border-black bg-ck-ink px-2 py-1 text-[10px] font-black uppercase text-white lg:inline-flex">Now</span>
            <% end %>
          </a>
        <% end %>

        <% if current_user&.admin? %>
          <div class="ck-meta hidden px-2 pt-4 lg:block">Admin</div>
          <% [
            [admin_categories_path, "Categories", "M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z", -> { request.path.start_with?('/admin/categories') }],
            [admin_settings_path,   "Settings",   "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z", -> { current_page?(admin_settings_path) }],
          ].each do |path, label, icon_d, active_fn| %>
            <% active = active_fn.call %>
            <a href="<%= path %>"
               class="flex min-w-max items-center gap-2 border-4 border-black px-3 py-2 text-sm font-black uppercase leading-none shadow-[4px_4px_0_0_#000] transition-transform duration-100 lg:min-w-0 lg:gap-3 lg:px-4 lg:py-3 <%= active ? 'translate-x-[2px] translate-y-[2px] bg-ck-accent shadow-none' : 'bg-white hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[7px_7px_0_0_#000]' %>">
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="<%= icon_d %>"></path>
              </svg>
              <span><%= label %></span>
            </a>
          <% end %>
        <% end %>
      <% else %>
        <a href="<%= new_user_session_path %>" class="ck-btn-outline min-w-max">Sign In</a>
        <a href="<%= new_user_registration_path %>" class="ck-btn-primary min-w-max">Sign Up</a>
      <% end %>
    </nav>

    <% if user_signed_in? %>
      <div class="hidden border-t-4 border-black bg-ck-muted px-4 py-4 lg:block">
        <div class="mb-4 flex items-center justify-between">
          <div class="ck-meta">Signal</div>
          <%= turbo_stream_from current_user, :notifications %>
          <%= render "nav/notifications", user: current_user %>
        </div>
        <div class="flex items-center gap-3">
          <a href="<%= user_path(current_user) %>" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-4 border-black bg-white text-sm font-black text-ck-ink shadow-[4px_4px_0_0_#000]" aria-label="View profile">
            <%= current_user.initials %>
          </a>
          <div class="min-w-0 flex-1">
            <div class="truncate text-base font-black leading-tight text-ck-ink"><%= current_user.full_name %></div>
            <div class="ck-meta mt-1 text-[10px]">Member</div>
          </div>
          <a href="<%= destroy_user_session_path %>" data-turbo-method="delete" class="flex h-11 w-11 shrink-0 items-center justify-center border-4 border-black bg-ck-accent shadow-[3px_3px_0_0_#000] transition-transform duration-100 hover:-translate-x-1 hover:-translate-y-1" aria-label="Sign out">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          </a>
        </div>
      </div>
    <% end %>
  </div>
</aside>
