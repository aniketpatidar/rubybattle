<div class="ck-page">
  <section class="mb-8 border-4 border-black bg-ck-muted p-5 shadow-[8px_8px_0_0_#000] sm:p-8 lg:p-10">
    <div class="ck-sticker mb-5">Discussions</div>
    <h1 class="ck-heading">Edit Discussion</h1>
  </section>

  <turbo-frame id="<%= dom_id(@discussion) %>">
    <div class="ck-card ck-card--quiet bg-white">
      <%= render("form", discussion: @discussion) %>
      <div class="mt-5">
        <%= link_to "Cancel", @discussion, class: "ck-btn-outline" %>
      </div>
    </div>
  </turbo-frame>
</div>
