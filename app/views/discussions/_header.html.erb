<turbo-frame id="<%= dom_id(discussion) %>">
  <article class="ck-card ck-card--quiet bg-white">
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[auto_minmax(0,1fr)]">
      <%= render "discussions/voting", discussion: discussion %>

      <div class="min-w-0">
        <div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
          <div>
            <div class="ck-sticker mb-4">Discussion</div>
            <h1 class="ck-heading max-w-5xl"><%= discussion.name %></h1>
          </div>
          <div class="flex shrink-0 flex-wrap gap-2">
            <% if discussion.pinned %><span class="ck-chip ck-chip--medium">Pinned</span><% end %>
            <% if discussion.closed %><span class="ck-chip ck-chip--hard">Closed</span><% end %>
            <% if defined?(current_user) && current_user&.admin? %>
              <%= link_to "Edit", edit_discussion_path(discussion), class: "ck-chip ck-chip--outline", data: { turbo_frame: "_top" } %>
              <%= button_to "Delete", discussion, method: :delete, data: { confirm: "Are you sure?", turbo_frame: "_top" }, class: "ck-chip ck-chip--hard" %>
            <% end %>
          </div>
        </div>

        <div class="trix-content text-lg font-bold leading-relaxed text-ck-ink">
          <%= discussion.description %>
        </div>
      </div>
    </div>
  </article>
</turbo-frame>
