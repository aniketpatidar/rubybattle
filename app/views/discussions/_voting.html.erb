<div id="<%= dom_id(discussion, :voting) %>" class="flex items-center gap-3 lg:flex-col">
  <%= button_to "▲", upvote_discussion_path(discussion), method: :put,
      data: { turbo_stream: dom_id(discussion, :voting) },
      class: "flex h-12 w-12 items-center justify-center border-4 border-black bg-ck-secondary text-2xl font-black leading-none shadow-[4px_4px_0_0_#000] transition-transform duration-100 hover:-translate-x-1 hover:-translate-y-1 #{upvote_icon(Current.user, discussion)}",
      aria: { label: "Upvote discussion" } %>

  <span class="flex h-14 min-w-14 items-center justify-center border-4 border-black bg-white px-3 text-2xl font-black tabular-nums shadow-[4px_4px_0_0_#000]">
    <%= discussion.total_vote_count %>
  </span>

  <%= button_to "▼", downvote_discussion_path(discussion), method: :put,
      data: { turbo_stream: dom_id(discussion, :voting) },
      class: "flex h-12 w-12 items-center justify-center border-4 border-black bg-ck-accent text-2xl font-black leading-none shadow-[4px_4px_0_0_#000] transition-transform duration-100 hover:-translate-x-1 hover:-translate-y-1 #{downvote_icon(Current.user, discussion)}",
      aria: { label: "Downvote discussion" } %>
</div>
