<turbo-frame id="<%= dom_id(post) %>">
  <article class="ck-card ck-card--quiet bg-white">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0 flex-1">
        <%= render partial: "discussions/posts/header", locals: { post: post } %>
        <div class="trix-content mt-3 text-base font-bold leading-relaxed text-ck-ink"><%= post.body %></div>
      </div>
      <% if Current.user&.admin? || Current.user&.id == post.user_id %>
        <div class="flex shrink-0 gap-2">
          <%= link_to "Edit", edit_discussion_post_path(post.discussion, post),
              data: { turbo_frame: dom_id(post) },
              class: "ck-chip ck-chip--outline" %>
          <%= button_to "Delete", discussion_post_path(post.discussion, post),
              method: :delete,
              data: { confirm: "Are you sure?" },
              class: "ck-chip ck-chip--hard" %>
        </div>
      <% end %>
    </div>
  </article>
</turbo-frame>
