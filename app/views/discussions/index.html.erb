<div class="ck-page overflow-hidden">
  <section class="relative mb-8 border-4 border-black bg-ck-muted p-5 shadow-[8px_8px_0_0_#000] sm:p-8 lg:p-10">
    <div class="absolute -right-8 -top-8 hidden h-28 w-28 rotate-12 border-4 border-black bg-ck-accent shadow-[6px_6px_0_0_#000] lg:block"></div>
    <div class="relative">
      <div class="ck-sticker mb-5">Community</div>
      <h1 class="ck-heading max-w-5xl">Discussions</h1>
    </div>
  </section>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
    <main class="space-y-6">
      <div class="ck-card ck-card--quiet bg-white">
        <form action="<%= discussions_path %>" method="get" class="grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,1fr)_auto_auto]">
          <%= text_field_tag :search,
              params[:search],
              placeholder: "Search discussions...",
              class: "ck-input min-w-0" %>
          <%= submit_tag "Search", class: "ck-btn-outline" %>
          <%= link_to "Ask", new_discussion_path, class: "ck-btn-primary" %>
        </form>
      </div>

      <div class="space-y-5">
        <% @discussions.each_with_index do |discussion, index| %>
          <article class="ck-card block <%= index.even? ? 'rotate-[-0.4deg]' : 'rotate-[0.4deg]' %>">
            <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
              <div class="min-w-0 flex-1">
                <div class="mb-3 flex flex-wrap gap-2">
                  <% discussion.categories.each do |category| %>
                    <span class="ck-chip ck-chip--outline"><%= category.name %></span>
                  <% end %>
                  <% if discussion.pinned %><span class="ck-chip ck-chip--medium">Pinned</span><% end %>
                  <% if discussion.closed %><span class="ck-chip ck-chip--hard">Closed</span><% end %>
                </div>
                <h2 class="mb-3 text-3xl font-black uppercase leading-none">
                  <%= link_to discussion.name, discussion_path(discussion), class: "text-ck-ink" %>
                </h2>
                <p class="text-base font-bold leading-snug text-ck-ink"><%= truncate(discussion.description.to_plain_text, length: 170) %></p>
                <div class="ck-meta mt-4 flex flex-wrap gap-3 text-[10px]">
                  <span>Asked by <%= discussion.user.full_name %></span>
                  <span><%= time_ago_in_words(discussion.created_at) %> ago</span>
                </div>
              </div>
              <div class="shrink-0 border-4 border-black bg-ck-secondary p-4 text-center shadow-[4px_4px_0_0_#000] lg:min-w-[120px]">
                <div class="text-5xl font-black leading-none tabular-nums"><%= discussion.posts.count %></div>
                <div class="ck-meta mt-2 text-[10px]">Posts</div>
              </div>
            </div>
          </article>
        <% end %>

        <% if @discussions.empty? %>
          <div class="ck-card bg-ck-muted text-center">
            <div class="ck-meta mb-3">No discussions found</div>
            <%= link_to "Ask the first Discussion", new_discussion_path, class: "ck-btn-primary" %>
          </div>
        <% end %>
      </div>
    </main>

    <aside class="space-y-6">
      <section class="ck-card ck-card--quiet bg-ck-secondary">
        <div class="ck-meta mb-4">Hot Discussions</div>
        <% @hot_discussions ||= Discussion.order('posts_count DESC').limit(5) %>
        <div class="space-y-4">
          <% @hot_discussions.each do |discussion| %>
            <a href="<%= discussion_path(discussion) %>" class="block border-4 border-black bg-white p-3 shadow-[4px_4px_0_0_#000]">
              <div class="text-base font-black uppercase leading-none text-ck-ink"><%= truncate(discussion.name, length: 46) %></div>
              <div class="ck-meta mt-2 text-[10px]"><%= discussion.posts.count %> Posts</div>
            </a>
          <% end %>
        </div>
      </section>

      <section class="ck-card ck-card--quiet bg-white">
        <div class="ck-meta mb-4">Categories</div>
        <div class="space-y-3">
          <% Category.all.limit(10).each do |category| %>
            <a href="<%= discussions_path(category_id: category.id) %>" class="flex items-center justify-between gap-3 border-4 border-black bg-ck-bg p-3 text-sm font-black uppercase shadow-[3px_3px_0_0_#000]">
              <span><%= category.name %></span>
              <span class="rounded-full border-2 border-black bg-ck-muted px-2 py-1 text-xs"><%= category.discussions.count %></span>
            </a>
          <% end %>
        </div>
      </section>
    </aside>
  </div>
</div>
