<a href="<%= notifications_path %>" class="relative inline-flex h-11 w-11 items-center justify-center border-4 border-black bg-white text-ck-ink shadow-[3px_3px_0_0_#000] transition-transform duration-100 hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[5px_5px_0_0_#000]">
  <span class="sr-only">Notifications</span>
  <%= inline_svg_tag('bell.svg', class: "h-5 w-5") %>
  <% if user.notifications.unread.exists? %>
    <div class="absolute -right-2 -top-2">
      <div class="inline-flex h-6 min-w-6 items-center justify-center rounded-full border-4 border-black bg-ck-accent px-1 text-[10px] font-black leading-none text-ck-ink">
        <%= user.notifications.unread.count %>
      </div>
    </div>
  <% end %>
</a>
